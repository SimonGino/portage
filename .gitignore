deploy/docker-compose.override.yml
!*.example.yaml

# frontend
node_modules/
# Vite 的 outDir 就在这儿（见 web/vite.config.ts）：Go 用 //go:embed 读它，
# 而 embed 只能读自己包目录下的文件，所以产物不能待在 web/ 里。
internal/webui/dist/

